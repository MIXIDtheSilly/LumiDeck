<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Keeps the taskbar above app windows (granted by scripts/setup-device.ps1). -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Checking after each boot that Android still uses LumiDeck as home (HomeCheck.kt). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        Quick settings (desktop/QuickSettings.kt). Brightness ("Modify system settings"),
        Do not disturb and Bluetooth's state need the PC client to grant them.
    -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Needed to list and launch every app from the app menu. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.LumiDeck">

        <!--
            Handheld screen. Android only uses a launcher's SECONDARY_HOME activity
            when that launcher is also the default HOME app, so LumiDeck has to be
            the default home. On the device's own screen this activity then forwards
            to the launcher the user picked (e.g. the stock Anbernic launcher).

            Direct-boot aware, like Launcher3: if the set of home apps differs before and
            after the device unlocks at boot, Android drops LumiDeck as the default.
        -->
        <activity
            android:name=".HomeActivity"
            android:directBootAware="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            The desktop. Android starts this on every display that shows system
            decorations: monitors over USB-C (with "force desktop mode" on) and the
            virtual display the PC client streams.
        -->
        <activity
            android:name=".DesktopActivity"
            android:directBootAware="true"
            android:exported="true"
            android:launchMode="singleTop"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustNothing"
            android:theme="@style/Theme.LumiDeck.Desktop"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboard|keyboardHidden|navigation">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.SECONDARY_HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
            The desktop's settings, opened as a window on the desktop. Its own task
            affinity keeps it out of the desktop's task, so it gets a window of its own.
        -->
        <activity
            android:name=".SettingsActivity"
            android:directBootAware="true"
            android:exported="false"
            android:label="Desktop Settings"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:taskAffinity="app.lumideck.settings"
            android:theme="@style/Theme.LumiDeck.Settings" />

        <receiver
            android:name=".HomeCheckReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!--
            Where the window helper (helper/WindowHelper.kt), started over ADB, connects
            so the taskbar can list and control app windows. Only the shell user may call it.
        -->
        <provider
            android:name=".helper.HelperProvider"
            android:authorities="app.lumideck.helper"
            android:directBootAware="true"
            android:exported="true" />
    </application>
</manifest>
