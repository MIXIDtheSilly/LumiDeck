<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Needed to list and launch every app from the app menu. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.LumiDeck">

        <!--
            Handheld screen. Android only uses a launcher's SECONDARY_HOME activity
            when that launcher is also the default HOME app, so LumiDeck has to be
            the default home. On the device's own screen this activity then forwards
            to the launcher the user picked (e.g. the stock Anbernic launcher).

            Direct-boot aware, like Launcher3: if the set of home apps differs before and
            after the device unlocks at boot, Android drops LumiDeck as the default.
        -->
        <activity
            android:name=".HomeActivity"
            android:directBootAware="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            The desktop. Android starts this on every display that shows system
            decorations: monitors over USB-C (with "force desktop mode" on) and the
            virtual display scrcpy creates for the PC window.
        -->
        <activity
            android:name=".DesktopActivity"
            android:directBootAware="true"
            android:exported="true"
            android:launchMode="singleTop"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustNothing"
            android:theme="@style/Theme.LumiDeck.Desktop"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboard|keyboardHidden|navigation">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.SECONDARY_HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
